# ============================================
# MARAUDER - Variables d'environnement
# ============================================

# ----- SERVEUR -----
PORT=3000
NODE_ENV=development

# ----- JWT -----
JWT_SECRET=change_this_secret_key_in_production

# ----- BASE DE DONNÉES (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_this_password
DB_NAME=marauder_db

# ----- API BRIXHUB -----
BRIX_API_KEY=brix_votre_cle_api

# ----- OPTIONS -----
# Railway SSL: true en production
# DATABASE_URL=postgresql://user:password@host:port/db